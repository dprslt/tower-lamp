{
  "extends": ["eslint:recommended", "plugin:react/recommended" ],
  "parserOptions": {
    "ecmaVersion": 2017,
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "parser": "babel-eslint",
  "plugins": [
    "promise",
    "react"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es6": true
  },
  "rules": {
    "semi": ["error", "never"],
    "no-console": "off"
  },
  "globals": {
    "API_REST_URL": true,
    "BASENAME_URL": true
  }
}
