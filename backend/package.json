{
  "name": "lamp-backend",
  "description": "Host the canvas used to proxy commandes via the FadeCandy ws.",
  "license": "MIT",
  "repository": "https://git.dprslt.fr/lights/lamp",
  "version": "1.0.0",
  "scripts": {
    "start": "node ./build/index.js",
    "start-dev": "node -r ./register.js src/index.ts",
    "build": "npm run build:types && npm run build:js",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "babel src --out-dir build --extensions \".ts,.tsx\" --source-maps inline",
    "check-types": "tsc"
  },
  "dependencies": {
    "canvas": "^2.6.1",
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "get-pixels": "^3.3.2",
    "konva": "^4.1.2",
    "konva-node": "^0.11.1",
    "log4js": "^6.1.0",
    "socket.io": "^2.3.0",
    "ws": "^6.2.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.6.4",
    "@babel/core": "^7.8.3",
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/plugin-proposal-object-rest-spread": "^7.8.3",
    "@babel/polyfill": "^7.8.3",
    "@babel/preset-env": "^7.8.3",
    "@babel/preset-typescript": "^7.8.3",
    "@babel/register": "^7.8.3",
    "@types/cors": "^2.8.6",
    "@types/express": "^4.17.2",
    "@types/socket.io": "^2.1.4",
    "@types/ws": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^2.16.0",
    "@typescript-eslint/parser": "^2.16.0",
    "core-js": "^3.6.4",
    "eslint": "^6.8.0",
    "typescript": "^3.7.5"
  }
}
